# Football Data API (football-data.org)
# Get your key at https://www.football-data.org/client/register
EXPO_PUBLIC_FOOTBALL_API_KEY=your_football_api_key_here

# Firebase Config
# Expo requires the EXPO_PUBLIC_ prefix to expose variables to the JS bundle.
# Variables WITHOUT this prefix are NOT accessible in your app code.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# OAuth — Google Sign-In only
# Web Client ID (type 3) — used by expo-auth-session webClientId and signInWithPopup
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Android Client ID — used by expo-auth-session androidClientId for native builds
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# ADK Agent Backend — Kick chatbot
# Run: cd adk-server && uvicorn main:app --reload
EXPO_PUBLIC_ADK_SERVER_URL=http://localhost:8000
